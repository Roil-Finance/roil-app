# Roil UI — Environment Reference
#
# Copy to `.env.local` for local dev. Values below are placeholders — no real
# secrets live in this file or anywhere in the repo. Server-side vars (marked
# SERVER) are set in the Vercel project's Environment Variables, NOT here.

# ── Frontend (VITE_*: bundled into the browser build, so PUBLIC by design) ──
VITE_BACKEND_URL=http://localhost:3001
VITE_LEDGER_URL=http://localhost:3975
# testnet | mainnet
VITE_NETWORK=testnet
# Google OAuth client ID (public identifier, safe to expose).
VITE_GOOGLE_CLIENT_ID=
# Cloudflare Turnstile PUBLIC site key (anti-spam on the waitlist form).
# Leave unset to disable the widget (soft mode).
VITE_TURNSTILE_SITE_KEY=

# ── SERVER (set in Vercel → Project "ui" → Settings → Environment Variables) ──
# These are never committed. Rotate them all after the handover.
#
# Neon Postgres connection string — stores waitlist signups (api/waitlist.ts).
#   DATABASE_URL=postgres://...
# Cloudflare Turnstile SECRET key — server-side verification (api/waitlist.ts).
#   TURNSTILE_SECRET_KEY=...
# Optional extra abuse/disposable email domains (comma-separated).
#   BLOCKED_EMAIL_DOMAINS=foo.com,bar.net
#
# Pre-launch gate (middleware.ts): while SITE_PASSWORD is set, roil.app (the
# full app) asks for HTTP Basic Auth — any username, this password. The public
# waitlist.roil.app subdomain is unaffected. REMOVE this var at launch to open
# the whole site.
#   SITE_PASSWORD=...
