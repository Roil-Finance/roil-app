# Roil UI Environment
VITE_BACKEND_URL=http://localhost:3001
VITE_LEDGER_URL=http://localhost:3975

# Cloudflare Turnstile (anti-spam on the waitlist form).
# Public site key — safe to expose. Leave unset to disable the widget (soft mode).
VITE_TURNSTILE_SITE_KEY=
# NOTE: the matching secret goes in the SERVER env (Vercel), NOT here:
#   TURNSTILE_SECRET_KEY=...           (verified in api/waitlist.ts)
# Optional extra abuse-domain blocklist (comma-separated), set in Vercel env:
#   BLOCKED_EMAIL_DOMAINS=foo.com,bar.net
